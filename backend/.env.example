# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=anaska_user
DB_PASSWORD=anaska_secret
DB_NAME=anaska_db
DATABASE_URL=postgresql://anaska_user:anaska_secret@localhost:5432/anaska_db

# JWT Secrets
